{
  "name": "site-manager",
  "private": true,
  "scripts": {
    "build": "esbuild entry.jsx --bundle --format=esm --minify --jsx=automatic --outfile=bundle.js && node scripts/stamp.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore \"node rules.test.mjs\"",
    "test:logic": "node logic.test.mjs",
    "test": "npm run test:logic && npm run test:worker && npm run test:render && npm run test:order && npm run test:dock && npm run test:rules",
    "test:render": "node render.test.mjs",
    "seed": "node scripts/seed-emulator.mjs",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:order": "node order-flow.test.mjs",
    "test:dock": "node dock.test.mjs",
    "test:worker": "node worker/files.test.mjs && node worker/limits.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.23.0",
    "firebase": "^12.18.0",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.436.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
