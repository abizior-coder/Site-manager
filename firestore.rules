rules_version = '2';

// Security is enforced here, on the server, not in the app. Hiding a panel in
// the UI is not access control — a crew member with the browser console must
// still be unable to read what the labour rate is.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberPath(cid) {
      return /databases/$(database)/documents/companies/$(cid)/members/$(request.auth.uid);
    }

    // A member who was removed keeps a document (their entries keep a name)
    // but no access: active == false is the same as not being there.
    function isMember(cid) {
      return signedIn() && exists(memberPath(cid)) && get(memberPath(cid)).data.get('active', true) != false;
    }

    function roleOf(cid) {
      return get(memberPath(cid)).data.role;
    }

    function isOwner(cid) {
      return isMember(cid) && roleOf(cid) == 'owner';
    }

    // A supervisor (Polier) runs the work: plans the days, approves hours and
    // absences, keeps projects up to date. Deliberately NOT the money — what
    // the company charges and earns stays with the owner.
    function canManage(cid) {
      return isMember(cid) && (roleOf(cid) == 'owner' || roleOf(cid) == 'supervisor');
    }

    // A user record points at the company the account belongs to.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      // The old personal key/value store. Still readable by its owner so the
      // migration can copy it, and so it remains a rollback path.
      match /kv/{key} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Invite codes. Any signed-in user may read one — they have to, to redeem
    // it before being a member — but only the issuing company's owner creates
    // or deletes them. Codes carry an expiry so a leaked code is not
    // permanent access.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && isOwner(resource.data.companyId);
      allow create: if signedIn() && isOwner(request.resource.data.companyId);
      // Deletes carry no incoming data, so the company must be read from the
      // existing document rather than request.resource.
      allow delete: if signedIn() && isOwner(resource.data.companyId);
      // Redeeming marks the code used; nothing else about it may change.
      allow update: if signedIn()
                    && resource.data.usedBy == null
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.companyId == resource.data.companyId
                    && request.resource.data.role == resource.data.role;
    }

    match /companies/{cid} {
      allow read: if isMember(cid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(cid);

      // Members may see who else is on the team. Only the owner changes roles
      // — otherwise a crew member could simply promote themselves.
      match /members/{uid} {
        allow read: if isMember(cid);
        allow update, delete: if isOwner(cid);
        // Joining: a user creates only their own membership, and only against
        // an unexpired invite that names this company. The role comes from the
        // invite, so it cannot be self-assigned.
        //
        // The first clause is the founding case: whoever the company record
        // names as its owner may create their own membership. Without it a new
        // owner could never be created, because isOwner() reads the very
        // document being written.
        allow create: if signedIn()
                      && request.auth.uid == uid
                      && (
                           get(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == request.auth.uid
                           || isOwner(cid)
                           || (
                                exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
                                && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.companyId == cid
                                && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time.toMillis()
                                && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == null
                                && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role
                              )
                         );
      }

      // What the crew costs the company is not the crew's business.
      match /private/{doc} {
        allow read, write: if isOwner(cid);
      }

      match /projects/{id} {
        allow read: if isMember(cid);
        allow write: if canManage(cid);
      }

      match /customers/{id} {
        allow read: if isMember(cid);
        allow write: if canManage(cid);
      }

      // A site log is a record of what happened. Crew add their own entries
      // and correct their own mistakes, but cannot quietly rewrite someone
      // else's hours.
      match /entries/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.userId == request.auth.uid;
        // Whoever may edit a row may not hand it to someone else: hours stay
        // attributed to the person who logged them.
        allow update: if (canManage(cid) || (isMember(cid) && resource.data.userId == request.auth.uid))
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if canManage(cid) || (isMember(cid) && resource.data.userId == request.auth.uid);
      }

      // Quotes, invoices and anything priced.
      match /documents/{id} {
        allow read, write: if isOwner(cid);
      }

      // Who is expected where, and when. Everyone needs to see the plan;
      // only the owner decides it — a crew member reassigning themselves
      // would make the schedule meaningless.
      match /assignments/{id} {
        allow read: if isMember(cid);
        allow write: if canManage(cid);
      }

      // Absences. Their own documents rather than fields in a shared blob,
      // because approval is a permission and permissions follow documents:
      // anyone may raise and amend their own request, only a manager decides it.
      match /leave/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if canManage(cid)
                              || (isMember(cid)
                                  && resource.data.userId == request.auth.uid
                                  && request.resource.data.userId == request.auth.uid
                                  && request.resource.data.status == resource.data.status);
      }

      // Signed site reports (Rapporte). The crew member on site captures the
      // customer's signature, so they must be able to create one. A report
      // that carries a signature can no longer be edited: its whole value is
      // being evidence of what the customer agreed to.
      match /reports/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.userId == request.auth.uid;
        allow update: if canManage(cid) && resource.data.signedAt == null;
        // A signed report is evidence. It cannot be edited, and it cannot be
        // deleted and re-created with different figures either.
        allow delete: if canManage(cid) && resource.data.signedAt == null;
      }

      // Reports sent to a supervisor. Their own documents rather than a field
      // in a shared blob, which was the last place two people saving at once
      // could still overwrite each other.
      match /sentReports/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.userId == request.auth.uid;
        allow update: if (canManage(cid) || (isMember(cid) && resource.data.userId == request.auth.uid))
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if canManage(cid) || (isMember(cid) && resource.data.userId == request.auth.uid);
      }

      // Plans and documents: the bytes live in R2 behind the Worker, which
      // checks membership by reading /members as the caller. This is the
      // metadata. Anyone on the job may add a plan; only a manager or the
      // person who uploaded it may take it away.
      // A link must be a web address, and a type must be something the
      // Worker would serve. The Worker refuses these at upload too; the rule
      // stops metadata being written around it.
      function fileMetaOk(d) {
        return (!('url' in d) || (d.url is string && d.url.matches('https?://.*')))
            && (!('type' in d) || (d.type is string && !d.type.lower().matches('(text/html|image/svg.*|application/xhtml.*|text/javascript).*')))
            && (!('size' in d) || (d.size is number && d.size <= 26214400))
            && (!('name' in d) || (d.name is string && d.name.size() <= 200));
      }
      match /files/{id} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.uploadedBy == request.auth.uid && fileMetaOk(request.resource.data);
        allow update: if (canManage(cid) || (isMember(cid) && resource.data.uploadedBy == request.auth.uid)) && fileMetaOk(request.resource.data);
        allow delete: if canManage(cid) || (isMember(cid) && resource.data.uploadedBy == request.auth.uid);
      }

      // Photos, preferences, technical library.
      // The key/value bucket used to be open to every member. It holds each
      // worker's insurance cards, emergency contact and running clock, every
      // site photo and the signatures behind signed reports -- none of which
      // a colleague has any business reading, let alone rewriting. Keys are
      // flat strings, so the rules match on prefix and on the caller's uid.
      match /kv/{key} {
        function mine(prefix) { return key == prefix + request.auth.uid; }
        function personal() {
          return mine('site-profile-') || mine('site-docs-') || mine('site-dock-pins-')
              || mine('site-lang-') || mine('clock-');
        }
        // Anyone's personal keys, whoever they belong to.
        function personalAny() {
          return key.matches('site-(profile|docs|dock-pins)-.*') || key.matches('clock-.*');
        }
        function isPhoto() { return key.matches('photo-.*'); }
        function isSignature() { return 'kind' in resource.data && resource.data.kind == 'signature'; }
        function photoOwner() { return 'by' in resource.data && resource.data.by == request.auth.uid; }
        function valueFits() {
          // A delete carries no incoming document.
          return request.method == 'delete'
              || !('value' in request.resource.data)
              || !(request.resource.data.value is string)
              || request.resource.data.value.size() <= 1000000;
        }
        // Read: my own personal keys; everything that is nobody's personal
        // key; managers additionally see every clock (who is on site).
        allow read: if isMember(cid) && (personal() || !personalAny());
        allow read: if canManage(cid) && key.matches('clock-.*');
        // Write: my own personal keys.
        allow write: if isMember(cid) && personal() && valueFits();
        // Photos: anyone may add one and must sign it; only its owner or a
        // manager may change or remove it; a signature is never touched.
        allow create: if isMember(cid) && isPhoto() && request.resource.data.by == request.auth.uid && valueFits();
        allow update, delete: if isMember(cid) && isPhoto() && !isSignature()
                              && (canManage(cid) || photoOwner()) && valueFits();
        // Shared and member-written: the article master, the tech library,
        // note translations and the language roster. Low sensitivity.
        allow write: if isMember(cid) && valueFits()
                     && (key == 'site-material-catalog' || key == 'site-tech-library'
                         || key == 'site-langs' || key.matches('xl-.*'));
        // Anything else that is nobody's personal key: managers.
        allow write: if canManage(cid) && !isPhoto() && !personalAny() && valueFits();
      }
    }

    // Everything else, including the pre-account public paths, stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
