#!/bin/sh
# The failsafe before every commit: nothing lands that does not lint, is not
# formatted, does not build, or fails the fast suites. The slow ones (rules
# emulator, Chromium e2e) run in CI. Skipping with --no-verify is not the
# way; fix what it says.
set -e
cd "$(git rev-parse --show-toplevel)"
# A source change lands with a dev-log entry (docs/DEVLOG.md) or not at all:
# the log and docs/CODE_MAP.md are what the next session starts from.
staged=$(git diff --cached --name-only | grep -vE '^(build/|sw\.js$|index\.html$|tailwind\.css$|package-lock\.json$)')
if echo "$staged" | grep -qE '\.(js|jsx|mjs|cjs|json|html|rules|css|py)$|^\.githooks/|^\.github/'; then
  if ! echo "$staged" | grep -q '^docs/DEVLOG.md$'; then
    echo "pre-commit: source files are staged but docs/DEVLOG.md has no staged entry"; exit 1
  fi
fi
echo "pre-commit: lint"
npx eslint . >/dev/null
echo "pre-commit: format"
npx prettier --check . >/dev/null
echo "pre-commit: build"
npm run -s build >/dev/null
for suite in logic render order-flow dock; do
  echo "pre-commit: $suite"
  out=$(node "$suite.test.mjs" 2>&1 | grep -E "passed, " | tail -1)
  case "$out" in
    *"0 failed"*) ;;
    *) echo "pre-commit: $suite is not green ($out)"; node "$suite.test.mjs" 2>&1 | grep -E "^FAIL" | head -5; exit 1;;
  esac
done
echo "pre-commit: worker"
npm run -s test:worker >/dev/null || { echo "pre-commit: worker suites are not green"; exit 1; }
# The build is part of the commit: stage what it produced.
git add build index.html sw.js tailwind.css >/dev/null 2>&1 || true
echo "pre-commit: green"
